# ------------------------------------------------------------------
# Variáveis de ambiente para o backend DENTRO do Docker Compose.
# Este arquivo é carregado via env_file no docker-compose.yml e tem
# prioridade sobre o .env da raiz (que é voltado para dev local sem Docker).
#
# DATABASE_URL fica vazia de propósito: força db.js a usar as variáveis
# DB_*, que apontam para o serviço 'db' (PostgreSQL) na rede interna.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000
JWT_SECRET=stream_music_super_secret_jwt_key_2026
CORS_ORIGIN=http://localhost:5173
VITE_LASTFM_API_KEY=1e0e47226b0fe4f793acbd570d544eab

# PostgreSQL — aponta para o container 'db' na rede do Docker Compose
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=288silva288
DB_HOST=db
DB_PORT=5432
DB_NAME=stream_music
